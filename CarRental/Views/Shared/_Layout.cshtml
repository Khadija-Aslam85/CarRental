<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Car Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root 
        {
            --dark-red: #A14646;
            --coral: #DA6556;
            --orange: #EB8B5B;
            --light-orange: #FDB872;
        }
        body
        {
            background-color: #fff6ee;   
            color: #4a2c2c;
        }
        .navbar 
        {
            background-color: var(--dark-red) !important;
            border-bottom: 4px solid var(--light-orange);
        }
        .navbar-brand 
        {
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        .nav-link 
        {
            color: #fde8d8 !important;
        }
        .nav-link:hover
        {
            color: var(--light-orange) !important;
        }
        h2 
        {
            color: var(--dark-red);
            font-weight: 700;
        }
        .card
        {
            border: none;
            border-top: 5px solid var(--coral);
            border-radius: 12px;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .card:hover
        {
            border-top-color: var(--orange);
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(161, 70, 70, 0.2) !important;
        }
        .card-title
        {
            color: var(--dark-red);
            font-weight: 600;
        }
        .btn-outline-secondary
        {
            color: var(--dark-red);
            border-color: var(--dark-red);
        }
        .btn-outline-secondary:hover\
        {
            background-color: var(--dark-red);
            border-color: var(--dark-red);
            color: #fff;
        }
        .table-dark
        {
            --bs-table-bg: var(--dark-red);
            --bs-table-border-color: var(--coral);
        }
        footer
        {
            background-color: var(--dark-red);
            color: #fde8d8;
            border-top: 4px solid var(--light-orange) !important;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/Cars/Index">Car Rental</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainMenu" aria-controls="mainMenu"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainMenu">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/Cars/Index">Available Cars</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Cars/Booked">Booked Cars</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4 flex-grow-1">
        @RenderBody()
    </div>

    <footer class="border-top text-center py-3">
        All rights reserved
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>